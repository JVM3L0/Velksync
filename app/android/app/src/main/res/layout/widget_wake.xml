<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×1 "Ligar PC" (ver WakeWidget.kt). Os textos daqui aparecem na prévia. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_icon_bg"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_widget_pc"
        android:tint="@color/widget_on_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Velksync"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ligar o PC"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/widget_power"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="Ligar"
            android:src="@drawable/ic_tile_power"
            android:tint="@color/widget_on_button" />

        <ProgressBar
            android:id="@+id/widget_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/widget_button"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
